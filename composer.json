{
    "name": "arionpay/arionpay-laravel",
    "description": "ArionPay for Laravel: crypto invoices and verified webhooks as Laravel events. Payments go straight to your own wallet.",
    "type": "library",
    "keywords": ["arionpay", "laravel", "crypto", "payments", "bitcoin", "usdt", "webhook"],
    "homepage": "https://arionpay.com",
    "license": "MIT",
    "authors": [{ "name": "ArionPay", "homepage": "https://arionpay.com" }],
    "require": {
        "php": "^8.1",
        "arionpay/arionpay-php": "^1.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": { "ArionPay\\Laravel\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["ArionPay\\Laravel\\ArionPayServiceProvider"],
            "aliases": { "ArionPay": "ArionPay\\Laravel\\Facades\\ArionPay" }
        }
    },
    "minimum-stability": "stable"
}
